{
  "expo": {
    "name": "Krishna Sanjeevani",
    "slug": "krishna-sanjeevani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "krishna-sanjeevani",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krishnasanjeevani.app"
    },
    "android": {
      "package": "com.krishnasanjeevani.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.29791277131-vmuvo1qjeurjbmh58kk4ue50r2epfi0k"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed1a30ea-7fd7-4712-9ba7-13a544769f84"
      }
    },
    "owner": "mr_ad"
  }
}
