# ─────────────────────────────────────────────────────────────
# Environment Variables — Template
# Copy to .env.local or .env.surawali / .env.emotion-remediation
# NEVER commit actual secrets to version control.
# ─────────────────────────────────────────────────────────────

# ── Application Mode ──
# Controls which product experience is active.
# Values: "surawali" | "emotion_remediation"
VITE_APP_MODE=surawali

# ── Backend API URL ──
# Uncomment and set if different from default
# VITE_API_BASE_URL=http://localhost:8787/api/v1

# ── Payment Credentials (Backend Only — DO NOT prefix with VITE_) ──
# Surawali Mode
SURAWALI_PAYMENT_KEY=your_surawali_razorpay_key_here
SURAWALI_PAYMENT_SECRET=your_surawali_razorpay_secret_here

# Emotion Remediation Mode
EMOTION_PAYMENT_KEY=your_emotion_razorpay_key_here
EMOTION_PAYMENT_SECRET=your_emotion_razorpay_secret_here

# ── JWT Secrets (Backend Only) ──
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# ── Payment Mode ──
# "mock" for development, "razorpay" for production
PAYMENT_MODE=mock

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Email / SMTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=your_email@example.com
